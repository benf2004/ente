<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:web.ente.io</string>
		<string>webcredentials:photos.ente.com</string>
		<string>webcredentials:auth.ente.io</string>
		<string>webcredentials:auth.ente.com</string>
		<string>webcredentials:locker.ente.com</string>
	</array>
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.ente.auth</string>
	</array>
	<!-- Must stay the first (and ideally only) entry. VaultStore omits
	     kSecAttrAccessGroup so that the app and the AutoFill extension both
	     default to this group; it is also the group Runner already used before
	     this entitlement existed, so flutter_secure_storage items are
	     unaffected. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)io.ente.auth</string>
	</array>
</dict>
</plist>
